#!/usr/bin/make -f
# Builds the deecure package. Run through scripts/build-deb.sh (make deb).
# The Rust toolchain comes from rustup (rust-toolchain.toml), not from Debian.

CARGO_TARGET_DIR ?= target
export CARGO_TARGET_DIR
BIN := $(CARGO_TARGET_DIR)/release
DEST := debian/deecure
APP := debian/deecure-desktop
ID := io.github.krisskad0.DeeCure

%:
	dh $@

override_dh_auto_configure:

# The web UI (app/dist) is built before packaging by scripts/build-deb.sh, which has Node.
override_dh_auto_build:
	test -f app/dist/index.html || { echo "app/dist is missing: run scripts/build-deb.sh" >&2; exit 1; }
	cargo build --release --locked --bin deecure --bin deecure-agent
	cargo build --release --locked -p deecure-desktop --features custom-protocol

# Tests run in CI with `make test`, not while packaging.
override_dh_auto_test:

# Keep the shared Cargo cache between builds.
override_dh_auto_clean:

override_dh_auto_install:
	install -D -m 0755 $(BIN)/deecure $(DEST)/usr/bin/deecure
	install -D -m 0755 $(BIN)/deecure-agent $(DEST)/usr/libexec/deecure/deecure-agent
	install -D -m 0644 packaging/systemd/deecure-agent.socket $(DEST)/usr/lib/systemd/user/deecure-agent.socket
	install -D -m 0644 packaging/systemd/deecure-agent.service $(DEST)/usr/lib/systemd/user/deecure-agent.service
	cd rules && find . -name '*.yaml' -exec install -D -m 0644 {} ../$(DEST)/usr/share/deecure/rules/{} \;
	cd kb && find . -name '*.yaml' -exec install -D -m 0644 {} ../$(DEST)/usr/share/deecure/kb/{} \;
	install -D -m 0755 $(BIN)/deecure-desktop $(APP)/usr/bin/deecure-desktop
	install -D -m 0644 packaging/desktop/$(ID).desktop $(APP)/usr/share/applications/$(ID).desktop
	install -D -m 0644 packaging/desktop/$(ID).metainfo.xml $(APP)/usr/share/metainfo/$(ID).metainfo.xml
	install -D -m 0644 packaging/desktop/deecure.svg $(APP)/usr/share/icons/hicolor/scalable/apps/$(ID).svg
	install -D -m 0644 app/src-tauri/icons/32x32.png $(APP)/usr/share/icons/hicolor/32x32/apps/$(ID).png
	install -D -m 0644 app/src-tauri/icons/128x128.png $(APP)/usr/share/icons/hicolor/128x128/apps/$(ID).png
	install -D -m 0644 app/src-tauri/icons/128x128@2x.png $(APP)/usr/share/icons/hicolor/256x256/apps/$(ID).png

