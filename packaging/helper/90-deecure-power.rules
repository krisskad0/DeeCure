# DeeCure: when a charger is plugged in or out, set the kept highest CPU speed and turbo on battery
# again, and a kept charge limit or charge mode the firmware lost. The helper returns at once when
# nothing is kept (docs/02-architecture/helper.md).
SUBSYSTEM=="power_supply", ACTION=="change", ATTR{type}=="Mains|USB", RUN+="/usr/libexec/deecure/deecure-helper --power-source-changed"
