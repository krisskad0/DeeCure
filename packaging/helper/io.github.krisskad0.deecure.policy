<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- One action per helper operation (docs/02-architecture/helper.md). Read and cleanup
     actions keep the approval for a few minutes; changes ask every time. -->
<policyconfig>
  <vendor>DeeCure</vendor>
  <vendor_url>https://github.com/krisskad0/DeeCure</vendor_url>
  <icon_name>io.github.krisskad0.DeeCure</icon_name>
  <action id="io.github.krisskad0.deecure.read">
    <description>Read admin-only details</description>
    <message>Authentication is required to read disk health, firewall rules, and other admin-only details</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.clean-apt-cache">
    <description>Clean the package cache</description>
    <message>Authentication is required to delete downloaded package files</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.vacuum-journal">
    <description>Shrink the system log</description>
    <message>Authentication is required to delete old system log files</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.remove-snap-revision">
    <description>Remove an old snap revision</description>
    <message>Authentication is required to remove a disabled snap revision</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.autoremove">
    <description>Remove packages no longer needed</description>
    <message>Authentication is required to remove packages</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.purge-residual">
    <description>Remove leftover package settings</description>
    <message>Authentication is required to remove settings of removed packages</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.upgrade-packages">
    <description>Install updates</description>
    <message>Authentication is required to install updates</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-firewall">
    <description>Turn the firewall on or off</description>
    <message>Authentication is required to change the firewall</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.restart-service">
    <description>Restart a service</description>
    <message>Authentication is required to restart a system service</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-service-enabled">
    <description>Turn a service on or off</description>
    <message>Authentication is required to start or stop a system service</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.remove-kernels">
    <description>Remove old kernels</description>
    <message>Authentication is required to remove old kernels</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-battery-action">
    <description>Change the low-battery action</description>
    <message>Authentication is required to change what happens when the battery is nearly empty</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-charge-limits">
    <description>Change the battery charge limits</description>
    <message>Authentication is required to change when the battery starts and stops charging</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-charge-mode">
    <description>Change the battery charge mode</description>
    <message>Authentication is required to change how the battery charges</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-turbo">
    <description>Turn CPU turbo on or off</description>
    <message>Authentication is required to turn CPU turbo on or off</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-device-wakeup">
    <description>Allow or stop a device waking the computer</description>
    <message>Authentication is required to change which devices may wake the computer</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-device-power-saving">
    <description>Turn power saving on or off for a device</description>
    <message>Authentication is required to change power saving for a device</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-battery-cpu-limit">
    <description>Limit the CPU speed on battery</description>
    <message>Authentication is required to change the CPU speed on battery</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-aspm-policy">
    <description>Change the PCIe power saving policy</description>
    <message>Authentication is required to change the PCIe power saving policy</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-suspend-mode">
    <description>Change the suspend type</description>
    <message>Authentication is required to change the suspend type</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-lid-action">
    <description>Change what closing the lid does</description>
    <message>Authentication is required to change what closing the lid does</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-battery-turbo">
    <description>Turn CPU turbo off on battery</description>
    <message>Authentication is required to change CPU turbo on battery</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-journal-cap">
    <description>Cap the system log size</description>
    <message>Authentication is required to cap the system log size</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-snap-retain">
    <description>Keep fewer old snap versions</description>
    <message>Authentication is required to change how many snap versions are kept</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.remove-unused-flatpaks">
    <description>Remove unused Flatpak runtimes</description>
    <message>Authentication is required to remove unused Flatpak runtimes</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-file-watch-limit">
    <description>Change the file-watch limit</description>
    <message>Authentication is required to change the file-watch limit</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-zswap">
    <description>Turn compressed swap on or off</description>
    <message>Authentication is required to change compressed swap</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.set-disk-scheduler">
    <description>Change a hard disk's scheduler</description>
    <message>Authentication is required to change a disk's scheduler</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.finish-package-setup">
    <description>Finish a broken package install</description>
    <message>Authentication is required to finish package installs</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.install-packages">
    <description>Install a driver package</description>
    <message>Authentication is required to install a driver package</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.krisskad0.deecure.rebuild-dkms">
    <description>Rebuild extra drivers for a kernel</description>
    <message>Authentication is required to rebuild drivers</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
