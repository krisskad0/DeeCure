[Unit]
Description=DeeCure admin helper
Documentation=https://github.com/krisskad0/DeeCure/blob/main/docs/02-architecture/helper.md

[Service]
Type=dbus
BusName=io.github.krisskad0.DeeCure.Helper
ExecStart=/usr/libexec/deecure/deecure-helper
# The helper runs package tools and systemctl, so it cannot be fully locked down;
# these limits still apply to everything it starts. No ProtectKernelModules: it makes
# /lib/modules read-only, so installing a kernel update or removing an old kernel fails
# half way. No ProtectKernelLogs: package scripts read the kernel log. No RestrictSUIDSGID:
# it stops dpkg from installing programs such as sudo and passwd, so their updates would fail.
PrivateTmp=yes
ProtectHome=read-only
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
UMask=0022
